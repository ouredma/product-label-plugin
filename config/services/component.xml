<?xml version="1.0" encoding="UTF-8"?>
<container xmlns="http://symfony.com/schema/dic/services" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">
    <services>
        <service
            id="integritty_sylius_product_badge_plugin.twig.component.product_badge.form"
            class="Sylius\Bundle\UiBundle\Twig\Component\ResourceFormComponent"
        >
            <argument type="service" id="integritty_sylius_product_badge_plugin.repository.product_badge" />
            <argument type="service" id="form.factory" />
            <argument>%integritty_sylius_product_badge_plugin.model.product_badge.class%</argument>
            <argument>Integritty\SyliusProductBadgePlugin\Form\Type\Admin\ProductBadgeType</argument>

            <tag name="sylius.live_component.admin" key="integritty:product_badge:form" />
        </service>
    </services>
</container>
