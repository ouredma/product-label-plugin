<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xmlns:gedmo="http://gediminasm.org/schemas/orm/doctrine-extensions-mapping"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                  https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <entity name="Integritty\SyliusProductBadgePlugin\Entity\ProductBadge" table="integritty_dev_sylius_product_badge">
        <id name="id" type="integer" column="id">
            <generator strategy="AUTO"/>
        </id>

        <field name="cssClass" type="string" column="css_class" nullable="true"/>

        <field name="createdAt" type="datetime" column="created_at">
            <gedmo:timestampable on="create"/>
        </field>

        <field name="updatedAt" type="datetime" column="updated_at" nullable="true">
            <gedmo:timestampable on="update"/>
        </field>

        <many-to-many field="products" target-entity="Integritty\SyliusProductBadgePlugin\Entity\ProductInterface" inversed-by="productBadges">
            <join-table name="integritty_product_badge_products">
                <join-columns>
                    <join-column name="product_badge_id" referenced-column-name="id"/>
                </join-columns>
                <inverse-join-columns>
                    <join-column name="product_id" referenced-column-name="id"/>
                </inverse-join-columns>
            </join-table>
        </many-to-many>
    </entity>

</doctrine-mapping>
