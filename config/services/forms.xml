<?xml version="1.0" encoding="UTF-8" ?>

<container
        xmlns="http://symfony.com/schema/dic/services"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd"
>
    <services>
        <service id="Integritty\SyliusProductBadgePlugin\Form\Type\Admin\ProductBadgeType">
            <argument>%integritty_sylius_product_badge_plugin.model.product_badge.class%</argument>
            <argument>%integritty_sylius_product_badge.css_classes%</argument>
            <argument type="collection">
                <argument>sylius</argument>
            </argument>
            <tag name="form.type" />
        </service>
        <service id="Integritty\SyliusProductBadgePlugin\Form\Type\Admin\ProductBadgeTranslationType">
            <argument>%integritty_sylius_product_badge_plugin.model.product_badge_translation.class%</argument>
            <argument type="collection">
                <argument>sylius</argument>
            </argument>
            <tag name="form.type" />
        </service>
        <service id="Integritty\SyliusProductBadgePlugin\Form\Type\Admin\ProductBadgeAutocompleteType" class="Integritty\SyliusProductBadgePlugin\Form\Type\Admin\ProductBadgeAutocompleteType" >
            <argument>%integritty_sylius_product_badge_plugin.model.product_badge.class%</argument>
            <tag name="form.type" />
            <tag name="ux.entity_autocomplete_field" />
        </service>
        <service id="Integritty\SyliusProductBadgePlugin\Form\Extension\Admin\ProductTypeExtension" class="Integritty\SyliusProductBadgePlugin\Form\Extension\Admin\ProductTypeExtension">
            <tag name="form.type_extension" priority="300" />
        </service>
    </services>
</container>
